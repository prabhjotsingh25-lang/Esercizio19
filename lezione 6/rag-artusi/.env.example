# Copia questo file in .env e adatta i valori. .env resta fuori da Git.

# Qdrant (docker compose up -d)
QDRANT_URL=http://localhost:6333
COLLEZIONE=artusi

# LM Studio sull'host, API compatibile con OpenAI (endpoint /v1/embeddings).
# da un container: http://host.docker.internal:1234/v1
LMSTUDIO_URL=http://localhost:1234/v1
# Identificativo esatto restituito da GET {LMSTUDIO_URL}/models
MODELLO_EMBEDDING=text-embedding-nomic-embed-text-v1.5

# Prefissi richiesti da nomic-embed-text-v1.5 (lo spazio finale fa parte del prefisso)
PREFISSO_DOCUMENTO="search_document: "
PREFISSO_QUERY="search_query: "

# Chunking: strategia paragrafi | caratteri
CHUNK_STRATEGIA=paragrafi
CHUNK_DIMENSIONE=1200
CHUNK_OVERLAP=200

EMBEDDING_BATCH=32
CORPUS=dati/artusi.txt

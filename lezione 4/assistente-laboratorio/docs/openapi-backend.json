  "components": {
    "schemas": {
      "ConversazioneBreve": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "titolo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Titolo"
          },
          "ultimo_messaggio": {
            "type": "string",
            "format": "date-time",
            "title": "Ultimo Messaggio",
            "description": "Data dell'ultimo messaggio (o della creazione)."
          }
        },
        "type": "object",
        "required": [
          "id",
          "titolo",
          "ultimo_messaggio"
        ],
        "title": "ConversazioneBreve"
      },
      "ConversazioneCompleta": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "titolo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Titolo"
          },
          "ultimo_messaggio": {
            "type": "string",
            "format": "date-time",
            "title": "Ultimo Messaggio",
            "description": "Data dell'ultimo messaggio (o della creazione)."
          },
          "preferenze": {
            "$ref": "#/components/schemas/Preferenze"
          },
          "turno_in_corso": {
            "type": "boolean",
            "title": "Turno In Corso"
          },
          "messaggi": {
            "items": {
              "$ref": "#/components/schemas/MessaggioApi"
            },
            "type": "array",
            "title": "Messaggi"
          }
        },
        "type": "object",
        "required": [
          "id",
          "titolo",
          "ultimo_messaggio",
          "preferenze",
          "turno_in_corso",
          "messaggi"
        ],
        "title": "ConversazioneCompleta"
      },
      "Errore": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Errore"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessaggioApi": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "posizione": {
            "type": "integer",
            "title": "Posizione"
          },
          "ruolo": {
            "type": "string",
            "title": "Ruolo",
            "description": "utente oppure assistente"
          },
          "testo": {
            "type": "string",
            "title": "Testo"
          },
          "strumenti": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strumenti",
            "description": "Risposte: strumenti usati."
          },
          "prompt": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt",
            "description": "Domande da /prompt: nome e argomenti."
          },
          "stato": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stato",
            "description": "Domande: in_attesa, risposta oppure errore."
          },
          "errore": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errore",
            "description": "Domande in errore: il motivo, da mostrare."
          },
          "creato": {
            "type": "string",
            "format": "date-time",
            "title": "Creato"
          }
        },
        "type": "object",
        "required": [
          "id",
          "posizione",
          "ruolo",
          "testo",
          "creato"
        ],
        "title": "MessaggioApi"
      },
      "Preferenze": {
        "properties": {
          "lingua": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "fr",
              "de",
              "es"
            ],
            "title": "Lingua",
            "default": "it"
          },
          "fuso_orario": {
            "type": "string",
            "title": "Fuso Orario",
            "default": "Europe/Rome"
          },
          "stile": {
            "type": "string",
            "enum": [
              "sintetico",
              "dettagliato"
            ],
            "title": "Stile",
            "default": "sintetico"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Preferenze",
        "description": "Lingua delle risposte, fuso orario predefinito (IANA) e stile."
      },
      "RichiestaNuova": {
        "properties": {
          "preferenze": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Preferenze"
              },
              {
                "type": "null"
              }
            ],
            "description": "Se mancano: lette una volta dalla fonte dell'host (resource o file)."
          }
        },
        "type": "object",
        "title": "RichiestaNuova"
      },
      "RichiestaPromptBackend": {
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "argomenti": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Argomenti"
          }
        },
        "type": "object",
        "required": [
          "nome"
        ],
        "title": "RichiestaPromptBackend"
      },
      "RichiestaTesto": {
        "properties": {
          "testo": {
            "type": "string",
            "minLength": 1,
            "title": "Testo"
          }
        },
        "type": "object",
        "required": [
          "testo"
        ],
        "title": "RichiestaTesto"
      },
      "Turno": {
        "properties": {
          "domanda": {
            "$ref": "#/components/schemas/MessaggioApi"
          },
          "risposta": {
            "$ref": "#/components/schemas/MessaggioApi"
          }
        },
        "type": "object",
        "required": [
          "domanda",
          "risposta"
        ],
        "title": "Turno"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e2b
MAX_PASSAGGI_STRUMENTO=3
LOG_LEVEL=INFO
# Variante degli strumenti: locale (in-process), http (servizio FastAPI) o mcp (server FastMCP)
VARIANTE_STRUMENTI=locale
# Usata solo con VARIANTE_STRUMENTI=http
STRUMENTI_HTTP_URL=http://localhost:8001
# Usata solo con VARIANTE_STRUMENTI=mcp
STRUMENTI_MCP_URL=http://localhost:8002/mcp
# Database SQLite delle note (default: note.sqlite nella cartella corrente)
NOTE_DB=note.sqlite
# Ambito dell'assistente (obbligatorio): il router rifiuta le domande che non vi rientrano.
# Elencare anche cosa è fuori ambito: senza, il router lasciava passare «cos'è il pH?».
AMBITO_AGENTE="Assistente di laboratorio: data e ora nei fusi orari, scadenze e giorni lavorativi, calcoli e conversioni di unità, inventario del laboratorio (quali attrezzature e materiali ci sono, dove si trovano, quanti ne abbiamo), note e promemoria, meteo. Sono in ambito anche saluti, ringraziamenti, domande su cosa sa fare l'assistente e domande che proseguono la conversazione. Sono fuori ambito le domande di cultura generale o di teoria (per esempio «cos'è il pH?» o «chi ha scoperto la penicillina?») e le richieste creative."

# Copia questo file in .env e adatta i valori. .env resta fuori da Git.

# Qdrant (docker compose up -d)
QDRANT_URL=http://localhost:6333
COLLEZIONE=artusi

# LM Studio sull'host, API compatibile con OpenAI (endpoint /v1/embeddings).
# da un container: http://host.docker.internal:1234/v1
LMSTUDIO_URL=http://localhost:1234/v1
# Identificativo esatto restituito da GET {LMSTUDIO_URL}/models
MODELLO_EMBEDDING=text-embedding-nomic-embed-text-v1.5

# Prefissi richiesti da nomic-embed-text-v1.5 (lo spazio finale fa parte del prefisso)
PREFISSO_DOCUMENTO="search_document: "
PREFISSO_QUERY="search_query: "

# Chunking: strategia paragrafi | caratteri
CHUNK_STRATEGIA=paragrafi
CHUNK_DIMENSIONE=1200
CHUNK_OVERLAP=200

# Testo passato all'embedder: titolo_capitolo (prefisso + "Titolo: …\nCapitolo: …\n\n" + chunk)
# oppure solo_testo (prefisso + chunk, come la valutazione di partenza). Cambiarlo richiede
# un'ingestion completa (python -m rag.ingestion) per ricalcolare gli embedding.
TESTO_INDICIZZATO=titolo_capitolo

EMBEDDING_BATCH=32
CORPUS=dati/artusi.txt

# --- Lezione 8: server di ricerca MCP (python -m rag.server_mcp) ---
# Massimo top_k concesso al modello (il codice non accetta più di 20)
RICERCA_TOP_K_MAX=10
# Lunghezza massima del testo di ogni passaggio inviato al modello (caratteri)
RICERCA_MAX_CARATTERI=800
# File di log facoltativo (oltre a stderr); vuoto = solo stderr
RICERCA_LOG_FILE=logs/ricerca.log

# --- Lezione 8 es. 3: modalità di ricerca (solo da configurazione, mai dal tool) ---
# base | riscrittura | reranking | entrambe
MODALITA_RICERCA=base
# Modello chat per riscrittura e reranking (id esatto di GET {LMSTUDIO_URL}/models)
MODELLO_CHAT=google/gemma-4-e2b
LLM_TEMPERATURA=0
# Vuoto = non inviato
LLM_SEED=42
# Ragionamento disattivato per compiti brevi; vuoto = parametro non inviato
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=300
LLM_TIMEOUT=60
# Query generate dalla riscrittura (1-3; la domanda originale si aggiunge sempre)
RISCRITTURA_MAX_QUERY=3
# Candidati chiesti a Qdrant per ogni query nelle modalità avanzate (1-20)
CANDIDATI_PER_QUERY=10
# Tetto dei candidati mandati al reranking e loro lunghezza massima (caratteri)
RERANK_MAX_CANDIDATI=10
RERANK_MAX_CARATTERI=400
# Costante della Reciprocal Rank Fusion: somma di 1/(RRF_K + rango)
RRF_K=60

# --- Lezione 8 es. 4: soglie di confidenza sul coseno (0-1, bassa <= alta) ---
# score >= alta: "affidabile"; tra le due: "media"; sotto la bassa: escluso. Valori
# calibrati il 2026-11-18 (docs/calibrazione-l8*.md): 14 domande, margine stretto, validi solo con
# query brevi del modello; da ricalibrare se cambia il modello di embedding o il modello chat.
SOGLIA_ALTA=0.73
SOGLIA_BASSA=0.70
# false = nessuna esclusione, fascia "non_valutata" (per il confronto con/senza soglie)
SOGLIE_ATTIVE=true

# Configurazione reale (contiene l'ambiente locale)
.env

# Ambienti virtuali
.venv/
venv/

# Cache Python e strumenti
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Pesi dei modelli (non vanno mai versionati)
*.gguf
*.safetensors
*.bin

# Note dell'utente (database SQLite): dati personali, mai nel repository
*.sqlite
*.sqlite-journal

# Preferenze reali dell'utente (dati personali): nel repository solo preferenze.example.json
preferenze.json
